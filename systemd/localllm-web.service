[Unit]
Description=localllm — веб-агент по трудовому праву (RAG по ТК РФ)
After=network-online.target ollama.service
Wants=ollama.service

[Service]
Type=simple
WorkingDirectory=/opt/localllm-web
ExecStart=/opt/localllm-web/.venv/bin/python web.py --url http://127.0.0.1:11434/v1 --model qwen2.5:3b --embed-model bge-m3 --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
